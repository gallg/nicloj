# Machine-specific: how this particular machine reaches clojure/javac/python.
# nicloj itself needs only `clojure` and `javac` on PATH, so these never belong
# in the repo. dev/check.sh is portable and is tracked.
dev/in-dev.sh
.venv/

# Build output and caches
target/
.cpcache/
*.class
*.jar

# Generated by scripts/gen_testdata.py and the test suite
test-data/

# Local editor and tooling state
.nrepl-port
.lsp/
.clj-kondo/
.calva/
.portal/
.idea/
.vscode/
*.iml

# Editor backups and OS noise
*~
*.orig
*.rej
.DS_Store
